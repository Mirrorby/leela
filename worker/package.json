{
  "name": "leela-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test:migrations": "node --test scripts/migrations.test.mjs",
    "test:local": "node scripts/smoke-local.mjs",
    "migrate:local": "node scripts/migrate.mjs --local",
    "migrate:remote": "node scripts/migrate.mjs --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261005.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  }
}
